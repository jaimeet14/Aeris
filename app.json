{
  "expo": {
    "name": "Aeris",
    "slug": "aeris",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aeris",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0D0F",
    "splash": {
      "backgroundColor": "#0D0D0F",
      "resizeMode": "contain"
    },
    "android": {
      "package": "com.jaimeet.aeris",
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0F"
      },
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.jaimeet.aeris",
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Aeris reads names and numbers so you can pick who you lent to or borrowed from. Your contacts stay on this phone."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "eas": {
        "projectId": "15dd704a-4a9f-4c7c-b438-78c1c748dab6"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/15dd704a-4a9f-4c7c-b438-78c1c748dab6"
    }
  }
}
