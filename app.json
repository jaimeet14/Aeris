{
  "expo": {
    "name": "Aeris",
    "slug": "aeris",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aeris",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0C0A",
    "android": {
      "package": "com.jaimeet.aeris",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#A3E635"
      },
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ],
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.jaimeet.aeris",
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-contacts",
        {
          "contactsPermission": "Aeris reads names and numbers so you can pick who you lent to or borrowed from. Your contacts stay on this phone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B0C0A"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "eas": {
        "projectId": "15dd704a-4a9f-4c7c-b438-78c1c748dab6"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/15dd704a-4a9f-4c7c-b438-78c1c748dab6"
    },
    "icon": "./assets/icon.png"
  }
}
